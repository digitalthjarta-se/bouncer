{
  "Bouncer": {
    "PollIntervalSeconds": 60,
    "Database": {
      "Path": "/var/lib/bouncer/bouncer.db"
    },
    "Pop3": {
      "Host": "mail.example.com",
      "Port": 995,
      "Security": "SslOnConnect",
      "Username": "bounces@example.com",
      "Password": null,
      "PasswordEnvVar": "BOUNCER_POP3_PASSWORD",
      "ConnectTimeoutSeconds": 30
    },
    "Retry": {
      "InitialBackoffSeconds": 60,
      "BackoffMultiplier": 2.0,
      "MaxBackoffSeconds": 3600
    },
    "Webhooks": {
      "TimeoutSeconds": 15,
      "MaxBatchSize": 200,
      "DefaultRoute": {
        "Enabled": true,
        "Url": "https://ops.example.com/hooks/unrouted-bounces",
        "BearerToken": null,
        "BearerTokenEnvVar": "BOUNCER_DEFAULT_WEBHOOK_TOKEN"
      },
      "Routes": [
        {
          "From": "app1@example.com",
          "Url": "https://app1.example.com/hooks/bounces",
          "BearerToken": null,
          "BearerTokenEnvVar": "BOUNCER_APP1_WEBHOOK_TOKEN"
        },
        {
          "From": "app2@example.com",
          "Url": "https://app2.example.com/hooks/bounces",
          "BearerToken": "inline-token-if-you-must"
        }
      ]
    },
    "ParseFailure": {
      "MaxAttempts": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "MailKit": "Warning"
    }
  }
}

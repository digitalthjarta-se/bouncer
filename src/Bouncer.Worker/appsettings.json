{
  "Bouncer": {
    "PollIntervalSeconds": 60,
    "Database": {
      "Path": "bouncer.db"
    },
    "Pop3": {
      "Host": "",
      "Port": 995,
      "Security": "SslOnConnect",
      "Username": "",
      "Password": null,
      "PasswordEnvVar": "BOUNCER_POP3_PASSWORD",
      "ConnectTimeoutSeconds": 30
    },
    "Retry": {
      "InitialBackoffSeconds": 60,
      "BackoffMultiplier": 2.0,
      "MaxBackoffSeconds": 3600
    },
    "Webhooks": {
      "TimeoutSeconds": 15,
      "MaxBatchSize": 200,
      "DefaultRoute": {
        "Enabled": false,
        "Url": null,
        "BearerToken": null,
        "BearerTokenEnvVar": null
      },
      "Routes": []
    },
    "ParseFailure": {
      "MaxAttempts": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "MailKit": "Warning"
    }
  }
}

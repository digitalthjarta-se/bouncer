[Unit]
Description=Bouncer - POP3 bounce mailbox monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bouncer
Group=bouncer
WorkingDirectory=/opt/bouncer
ExecStart=/usr/bin/dotnet /opt/bouncer/Bouncer.Worker.dll
EnvironmentFile=/etc/bouncer/bouncer.env
Restart=on-failure
RestartSec=10
SyslogIdentifier=bouncer

[Install]
WantedBy=multi-user.target

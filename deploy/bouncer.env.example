# Copy to /etc/bouncer/bouncer.env (referenced by deploy/bouncer.service) and fill in real values.
# Never commit the filled-in version.

BOUNCER_POP3_PASSWORD=
BOUNCER_DEFAULT_WEBHOOK_TOKEN=
BOUNCER_APP1_WEBHOOK_TOKEN=

# Overrides appsettings.json's Database:Path / config location if needed:
# Bouncer__Database__Path=/var/lib/bouncer/bouncer.db
